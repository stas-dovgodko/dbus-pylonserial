[serial]
# Pylontech console cable connected to the master battery.
port = /dev/ttyUSB0
baudrate = 115200
timeout = 5
# Minimum pause between console commands. Slave modules often need 1.2 seconds.
command_delay = 1.2

[battery]
# Use 0 for discovery. Set the real count to reject partial responses.
expected_modules = 0
# Used only for InstalledCapacity and remaining Capacity. Use 0 if unknown.
module_capacity_ah = 0
custom_name = Pylontech RS232
# Reserve custom D-Bus paths for this many modules.
max_modules = 16
# Maximum number of cell paths reserved for each module.
max_cells_per_module = 16

[driver]
poll_interval = 5
# Read info/stat/bat details less frequently than the live pwr summary.
details_poll_interval = 60
failure_threshold = 3
device_instance = 288
# The DC-load service type is visible in Devices but is not a battery source.
service_name = com.victronenergy.dcload.pylontechmonitor_rs232
log_level = INFO
