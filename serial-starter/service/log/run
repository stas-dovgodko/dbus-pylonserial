#!/bin/sh
set -eu

# serial-starter may link this logger directly to the persistent template.
# Derive the TTY from the generated service name when possible so each port
# writes to its own log directory.
SERVICE_DIR=$(CDPATH= cd -- "$(dirname -- "$(dirname -- "$0")")" && pwd)
DEVICE_NAME=${SERVICE_DIR##*.}
RUN_DIR=$(pwd)
RUN_SERVICE_DIR=${RUN_DIR%/log}
RUN_DEVICE_NAME=${RUN_SERVICE_DIR##*.}
case "$RUN_DEVICE_NAME" in
    tty*) DEVICE_NAME=$RUN_DEVICE_NAME ;;
esac
if ! printf '%s\n' "$DEVICE_NAME" | grep -q '^tty'; then
    for CANDIDATE in "${SERIAL_PORT:-}" "${TTY:-}"; do
        case "$CANDIDATE" in
            /dev/tty*) DEVICE_NAME=${CANDIDATE##*/}; break ;;
            tty*) DEVICE_NAME=$CANDIDATE; break ;;
        esac
    done
fi
if ! printf '%s\n' "$DEVICE_NAME" | grep -q '^tty'; then
    TEMPLATE_TARGET=$(readlink -f "$SERVICE_DIR" 2>/dev/null || true)
    MATCHED_DEVICE=""
    for SERVICE_PATH in /service/dbus-pylonserial.tty*; do
        [ -e "$SERVICE_PATH" ] || continue
        SERVICE_TARGET=$(readlink -f "$SERVICE_PATH" 2>/dev/null || true)
        [ -n "$TEMPLATE_TARGET" ] && [ "$SERVICE_TARGET" = "$TEMPLATE_TARGET" ] || continue
        CANDIDATE=${SERVICE_PATH##*.}
        if [ -n "$MATCHED_DEVICE" ] && [ "$MATCHED_DEVICE" != "$CANDIDATE" ]; then
            echo "Multiple dbus-pylonserial services point to the same template" >&2
            exit 1
        fi
        MATCHED_DEVICE=$CANDIDATE
    done
    [ -n "$MATCHED_DEVICE" ] && DEVICE_NAME=$MATCHED_DEVICE
fi
case "$DEVICE_NAME" in
    tty*) LOG_DIR="/data/log/dbus-pylonserial.$DEVICE_NAME" ;;
    *)
        echo "Unable to resolve the serial TTY for the logger" >&2
        exit 1
        ;;
esac

exec 2>&1
exec multilog t s25000 n4 "$LOG_DIR"
