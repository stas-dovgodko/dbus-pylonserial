#!/bin/sh
set -eu

APP_DIR="/data/apps/dbus-pylontech-console"
export PYTHONPATH="/opt/victronenergy/dbus-systemcalc-py/ext/velib_python${PYTHONPATH:+:$PYTHONPATH}"

# serial-starter may execute this template without replacing a /dev/TTY
# placeholder. The generated service directory always contains the real TTY
# name, so derive the port from it instead of relying on substitution.
SERVICE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DEVICE_NAME=${SERVICE_DIR##*.}
RUN_DIR=$(pwd -P)
RUN_DEVICE_NAME=${RUN_DIR##*.}
case "$RUN_DEVICE_NAME" in
    tty*) DEVICE_NAME=$RUN_DEVICE_NAME ;;
esac
if ! printf '%s\n' "$DEVICE_NAME" | grep -q '^tty'; then
    # Some Venus releases pass the port through an environment variable when
    # executing a persistent template instead of creating a runtime copy.
    for CANDIDATE in "${SERIAL_PORT:-}" "${TTY:-}"; do
        case "$CANDIDATE" in
            /dev/tty*) DEVICE_NAME=${CANDIDATE##*/}; break ;;
            tty*) DEVICE_NAME=$CANDIDATE; break ;;
        esac
    done
fi
case "$DEVICE_NAME" in
    tty*) SERIAL_PORT="/dev/$DEVICE_NAME" ;;
    *)
        echo "Unable to resolve the serial TTY from the service directory" >&2
        exit 1
        ;;
esac

exec 2>&1
exec /usr/bin/python3 -u "$APP_DIR/main.py" \
    --config "$APP_DIR/config.ini" \
    --serial-port "$SERIAL_PORT" \
    --serial-starter
